# Copy to .env.local on the server and fill in. Never commit the real file.

# Admin portal login (the build refuses to start without these two)
BAGCO_ADMIN_PASSWORD=
BAGCO_ADMIN_SECRET=          # long random string: openssl rand -hex 32

# Discord webhooks (create new ones; the old URLs were public on GitHub)
LEAD_WEBHOOK_URL=            # contact / quick quote / newsletter leads
QUOTE_WEBHOOK_URL=           # makeyourquote configurator leads
SAMPLES_WEBHOOK_URL=         # sample requests
DISTRIBUTOR_WEBHOOK_URL=     # distributor applications
VISITOR_WEBHOOK_URL=         # /api/visitors beacon (bagsupplyco.com)
BUDBAGS_VISITOR_WEBHOOK_URL= # /api/visitors beacon (budbags.net), separate from the above
REQUEST_LOG_WEBHOOK_URL=     # every page view, separate channel; leave blank to turn off
CENSUS_API_KEY=              # only for: npm run seo:build-data
